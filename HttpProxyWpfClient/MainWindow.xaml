<ui:FluentWindow x:Class="HttpProxyWpfClient.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:HttpProxyWpfClient"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:HttpProxyWpfClient.code.Loc"
                 mc:Ignorable="d"
                 Title="HttpProxyWpfClient" Height="1000" Width="1500"
                 DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- 标题栏：三列布局 -->
        <Border Grid.Row="0" x:Name="TitleBar"
                Background="#FF1E1E1E"
                Height="36"
                VerticalAlignment="Top"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image Grid.Column="0"
                       Source="Resources/image/雪切.logo.ico"
                       Width="24" Height="24"
                       Margin="8,6" />

                <!-- 标题文本 -->
                <TextBlock Grid.Column="1"
                           Text=""
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="8,0,0,0" />

                <!-- 窗口按钮组 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- 最小化 -->
                    <Button Width="46" Height="36" Padding="0"
                            ToolTip="{loc:Loc Minimize}"
                            Click="Minimize_Click"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Path Data="M0,0 L10,0" Stroke="White" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <!-- 最大化/还原 -->
                    <Button x:Name="MaxRestoreButton"
                            Width="46" Height="36" Padding="0"
                            ToolTip="{loc:Loc Maximize}"
                            Click="MaximizeRestore_Click"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle x:Name="MaxIcon"
                                       Stroke="White" StrokeThickness="2"
                                       Width="10" Height="10" />
                            <Rectangle x:Name="RestoreIcon"
                                       Stroke="White" StrokeThickness="2"
                                       Width="8" Height="8"
                                       Visibility="Collapsed" Margin="2,2,0,0" />
                        </Grid>
                    </Button>
                    <!-- 关闭 -->
                    <Button Width="46" Height="36" Padding="0"
                            ToolTip="{loc:Loc Close}"
                            Click="Close_Click"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="White" StrokeThickness="2"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ui:NavigationView Grid.Row="1" PaneDisplayMode="Top">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Name="HomePage" Click="SelectionChanged"  Tag="Main" Content="{loc:Loc HomePage}"/>
                <ui:NavigationViewItem Name="SettingPage" Click="SelectionChanged"  Tag="Setting" Content="{loc:Loc Setting}"/>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
        <Frame x:Name="RootFrame"
               Grid.Row="2"
               NavigationUIVisibility="Hidden"/>
        <!-- <Grid Grid.Row="2" Background="Blue"></Grid> -->
    </Grid>

</ui:FluentWindow>