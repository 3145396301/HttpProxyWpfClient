<Page x:Class="HttpProxyWpfClient.code.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HttpProxyWpfClient.code.Loc"
      xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
      mc:Ignorable="d"
      Title="Main"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="320"/>
                        <Setter Property="MinWidth" Value="200"/>
                        <Setter Property="MaxWidth" Value="800"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchPanelOpen}" Value="False">
                                <Setter Property="Width" Value="0"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MaxWidth" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部按钮栏 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <ui:Button Click="block_OnClick" Margin="0,0,5,0">拦截</ui:Button>
            <ui:Button Click="discharged_OnClick" Margin="0,0,15,0">全部放行</ui:Button>

            <ui:TextBlock Text="只展示拦截请求" Foreground="AliceBlue" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ui:ToggleSwitch Name="OnlyShowInterceptedToggle"
                              IsChecked="{Binding OnlyShowIntercepted, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,15,0"/>

            <ui:TextBlock Text="直接丢弃非拦截请求" Foreground="AliceBlue" VerticalAlignment="Center" Margin="0,0,5,0"
                          Visibility="{Binding OnlyShowIntercepted, Converter={StaticResource BoolToVisibility}}"/>
            <ui:ToggleSwitch Name="DiscardNonInterceptedToggle"
                              IsChecked="{Binding DiscardNonIntercepted, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,15,0"
                              Visibility="{Binding OnlyShowIntercepted, Converter={StaticResource BoolToVisibility}}"/>

            <ui:Button Click="Search_OnClick">搜索 (Ctrl+F)</ui:Button>
        </StackPanel>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- 左侧会话列表 -->
            <ui:ListView x:Name="SessionListView" Grid.Column="0" ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}"
                         SelectionChanged="Selector_OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.IsVirtualizing="False"
                         KeyDown="UIElement_OnKeyDown"
                         PreviewMouseRightButtonDown="SessionList_OnPreviewMouseRightButtonDown"
                         ContextMenuOpening="SessionList_OnContextMenuOpening">
                <ui:ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制为 curl">
                            <MenuItem Header="cmd" Click="CopyCurlCmd_OnClick"/>
                            <MenuItem Header="bash" Click="CopyCurlBash_OnClick"/>
                            <MenuItem Header="PowerShell" Click="CopyCurlPowerShell_OnClick"/>
                        </MenuItem>
                    </ContextMenu>
                </ui:ListView.ContextMenu>
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn x:Name="ColUp" Header="上行" Width="40">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Orange">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockingRequest}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn x:Name="ColDown" Header="下行" Width="40">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Red">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Blocking}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
<ui:GridViewColumn x:Name="ColHost" Header="{loc:Loc Host}" DisplayMemberBinding="{Binding Host}" Width="120" />
                        <ui:GridViewColumn x:Name="ColProtocol" Header="{loc:Loc Protocol}" DisplayMemberBinding="{Binding Protocol}" Width="70" />
                        <ui:GridViewColumn x:Name="ColMethod" Header="{loc:Loc Method}" DisplayMemberBinding="{Binding Method}" Width="70" />
                        <ui:GridViewColumn x:Name="ColPath" Header="{loc:Loc Path}" DisplayMemberBinding="{Binding Url}" Width="200" />
                        <ui:GridViewColumn x:Name="ColContentType" Header="响应类型" DisplayMemberBinding="{Binding ResponseContentType}" Width="130" />
                        <ui:GridViewColumn x:Name="ColContentLength" Header="响应长度" DisplayMemberBinding="{Binding ResponseLengthDisplay}" Width="90" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" />

            <!-- 右侧详情区域 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 请求内容 -->
                <Border Grid.Row="0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Text="请求内容" Margin="5,2" FontWeight="SemiBold" Foreground="White"/>

                        <avalonedit:TextEditor Name="RequestEditor" Grid.Row="1"
                                                Background="Transparent" Foreground="White"
                                                FontFamily="Consolas" WordWrap="False"
                                                IsReadOnly="{Binding RequestMessage.IsTruncated}"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                ShowLineNumbers="False"
                                                PreviewMouseWheel="ContentEditor_OnPreviewMouseWheel"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <ui:Button Click="EditRequestBody_OnClick" Margin="0,0,5,0"
                                       Visibility="{Binding RequestMessage.IsTruncated, Converter={StaticResource BoolToVisibility}}">编辑完整请求体</ui:Button>
                            <ui:Button Click="PassRequest_OnClick">放行</ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
<!-- 垂直分割线 -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeNS" />

                <!-- 响应内容 -->
                <Border Grid.Row="2" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Text="响应内容" Margin="5,2" FontWeight="SemiBold"
                                   Foreground="White" />

                        <avalonedit:TextEditor Name="ResponseEditor" Grid.Row="1"
                                                Background="Transparent" Foreground="White"
                                                FontFamily="Consolas" WordWrap="False"
                                                IsReadOnly="{Binding ResponseMessage.IsTruncated}"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto"
                                                ShowLineNumbers="False"
                                                PreviewMouseWheel="ContentEditor_OnPreviewMouseWheel"/>

                        <!-- 操作按钮 + 失败/未完成提示 -->
                        <Grid Grid.Row="2" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Grid.Column="0" Text="{Binding ResponseMessage.ErrorText}"
                                       Foreground="#FFD72B2B" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Cursor="Hand"
                                       MouseLeftButtonUp="ErrorText_OnClick">
                                <ui:TextBlock.Style>
                                    <Style TargetType="{x:Type ui:TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResponseMessage.HasError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Click="Pass_OnClick" Margin="0,0,5,0">放行</ui:Button>
                                <ui:Button Click="EditResponseBody_OnClick" Margin="0,0,5,0"
                                           Visibility="{Binding ResponseMessage.IsTruncated, Converter={StaticResource BoolToVisibility}}">编辑完整响应体</ui:Button>
                                <ui:Button Name="ModifyRequestBody" Click="ModifyRequestBody_OnClick">快捷修改请求体</ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <!-- 分割线：搜索侧边栏 -->
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Left"
                      Background="White" Cursor="SizeWE"
                      Visibility="{Binding IsSearchPanelOpen, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 搜索侧边栏 -->
        <Border Grid.Column="1" Margin="5,0,0,0"
                CornerRadius="3" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Visibility="{Binding IsSearchPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Name="SearchKeywordTextBox" Grid.Column="0"
                                Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="SearchKeywordTextBox_OnKeyDown"/>
                    <ui:Button Grid.Column="1" Margin="4,0,0,0" Click="ReSearch_OnClick">重新搜索</ui:Button>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox Content="启用正则表达式" IsChecked="{Binding SearchUseRegex}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                    <ui:TextBlock Text="搜索范围：" Foreground="AliceBlue" Margin="0,0,0,4"/>
                    <WrapPanel>
                        <CheckBox Content="域名" Margin="0,0,10,4" IsChecked="{Binding SearchFieldHost}"/>
                        <CheckBox Content="URL" Margin="0,0,10,4" IsChecked="{Binding SearchFieldUrl}"/>
                        <CheckBox Content="方法" Margin="0,0,10,4" IsChecked="{Binding SearchFieldMethod}"/>
                        <CheckBox Content="状态码" Margin="0,0,10,4" IsChecked="{Binding SearchFieldStatusCode}"/>
                        <CheckBox Content="请求头" Margin="0,0,10,4" IsChecked="{Binding SearchFieldRequestHeaders}"/>
                        <CheckBox Content="请求体" Margin="0,0,10,4" IsChecked="{Binding SearchFieldRequestBody}"/>
                        <CheckBox Content="响应头" Margin="0,0,10,4" IsChecked="{Binding SearchFieldResponseHeaders}"/>
                        <CheckBox Content="响应体" Margin="0,0,10,4" IsChecked="{Binding SearchFieldResponseBody}"/>
                    </WrapPanel>
                </StackPanel>

                <ui:ListView Grid.Row="3" Name="SearchResultsListView"
                             ItemsSource="{Binding SearchResults}"
                             MouseDoubleClick="SearchResultsListView_OnMouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <ui:TextBlock Text="{Binding RequestVo.Url}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <ui:TextBlock Text="{Binding FieldDisplayName}" FontSize="11" Opacity="0.7"/>
                                <ui:TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" FontSize="11" Opacity="0.85"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ui:ListView>
            </Grid>
        </Border>
    </Grid>
</Page>