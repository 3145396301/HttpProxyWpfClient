<Page x:Class="HttpProxyWpfClient.code.Pages.Setting.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HttpProxyWpfClient.code.Pages.Setting"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:HttpProxyWpfClient.code.Loc"
      mc:Ignorable="d"
      Title="{loc:Loc ProxySetting}"
      Loaded="SettingPage_OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- 界面语言部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Language}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label Content="{loc:Loc Language}" VerticalAlignment="Center"/>
                        <ComboBox Name="LanguageComboBox"
                                  Width="200"
                                  Margin="8,0,0,0"
                                  SelectionChanged="LanguageComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                            <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                            <ComboBoxItem Content="한국어" Tag="ko-KR"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 刷新代理部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc ProxyControl}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="{loc:Loc RefreshProxyNow}"
                                Name="RefreshProxyButton"
                                Click="RefreshProxyButton_OnClick"
                                Padding="16,8"
                                Margin="0,0,12,0"/>

                        <Button Content="{loc:Loc CloseProxy}"
                                Name="CloseProxyButton"
                                Click="CloseProxyButton_OnClick"
                                Padding="16,8"
                                Background="#FFD72B2B"
                                Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 本地代理设置部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Expander Header="{loc:Loc LocalProxySetting}" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{loc:Loc ProxyAddress}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0" Grid.Column="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Name="LocalProxyAddressTextBox"
                                     Text="0.0.0.0"
                                     Margin="8,4"
                                     Padding="8,4"/>

                            <Label Content="{loc:Loc ProxyPort}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1" Grid.Column="0"
                                   Margin="0,12,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Name="LocalProxyPortTextBox"
                                     Text="8000"
                                     Padding="8,4"
                                     Margin="8,12,8,0"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 上游代理设置部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16">
                <Expander Header="{loc:Loc UpstreamProxySetting}" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Label Content="{loc:Loc EnableUpstream}"
                                   VerticalAlignment="Center"/>
                            <ui:ToggleSwitch Name="UpstreamEnabledToggle"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{loc:Loc ProxyAddress}"
                                   VerticalAlignment="Center"
                                   Grid.Row="0" Grid.Column="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Name="UpstreamProxyAddressTextBox"
                                     Text="127.0.0.1"
                                     Margin="8,4"
                                     Padding="8,4"/>

                            <Label Content="{loc:Loc ProxyPort}"
                                   VerticalAlignment="Center"
                                   Grid.Row="1" Grid.Column="0"
                                   Margin="0,12,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Name="UpstreamProxyPortTextBox"
                                     Text="10808"
                                     Padding="8,4"
                                     Margin="8,12,8,0"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
