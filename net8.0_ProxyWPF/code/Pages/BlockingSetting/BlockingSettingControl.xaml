<UserControl x:Class="net8._0_ProxyWPF.code.Pages.BlockingSetting.BlockingSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:net8._0_ProxyWPF.code.Pages.BlockingSetting"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             d:DesignHeight="600" d:DesignWidth="800">

    <Border Padding="16" Background="{DynamicResource SystemControlPageBackgroundChromeMediumLowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0"
                    Padding="16"
                    Margin="0,0,0,16"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           VerticalAlignment="Center"
                           Content="规则名称"
                           Margin="0,0,12,0"
                           FontWeight="SemiBold" />

                    <ui:TextBox Grid.Column="1"
                                PlaceholderText="请输入名称"
                                VerticalAlignment="Center"
                                Name="NewRuleName"
                                Margin="0,0,12,0" />

                    <ui:Button Grid.Column="2"
                               VerticalAlignment="Center"
                               Appearance="Primary"
                               Content="新增规则"
                               MinWidth="100"
                               Click="NewRule_OnClick"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- Rules List Section -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0"
                            Padding="12,8"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <TextBlock Text="当前拦截规则"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Rules List -->
                    <ui:ListView Grid.Row="1"
                                 ItemsSource="{Binding requestMatches}"
                                 Padding="8"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False">
                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ui:ListView.ItemContainerStyle>

                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                    <Expander Header="{Binding Name}"
                                              FontWeight="SemiBold"
                                              IsExpanded="False">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Rule Properties -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Label Grid.Row="0" Grid.Column="0"
                                                       Content="名称:"
                                                       Margin="0,0,12,8"
                                                       FontWeight="SemiBold" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Name="Name"
                                                         Margin="0,0,0,8"
                                                         Text="{Binding Name, Mode=TwoWay}" />

                                                <Label Grid.Row="1" Grid.Column="0"
                                                       Content="URL:"
                                                       Margin="0,0,12,8"
                                                       FontWeight="SemiBold" />
                                                <TextBox Grid.Row="1" Grid.Column="1"
                                                         Name="Url"
                                                         Margin="0,0,0,8"
                                                         Text="{Binding Url, Mode=TwoWay}" />

                                                <Label Grid.Row="2" Grid.Column="0"
                                                       Content="方法:"
                                                       Margin="0,0,12,8"
                                                       FontWeight="SemiBold" />
                                                <TextBox Grid.Row="2" Grid.Column="1"
                                                         Name="Method"
                                                         Margin="0,0,0,0"
                                                         Text="{Binding Method, Mode=TwoWay}" />
                                            </Grid>

                                            <!-- Headers Section Header -->
                                            <Border Grid.Row="1"
                                                    Padding="8"
                                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                    CornerRadius="4"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="请求头规则"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>

                                                    <ui:Button Grid.Column="2"
                                                               Content="新增请求头"
                                                               Appearance="Secondary"
                                                               MinWidth="100"
                                                               Click="AddHeader_Click"
                                                               FontWeight="Normal"/>
                                                </Grid>
                                            </Border>

                                            <!-- Headers List -->
                                            <ui:ListView Grid.Row="2"
                                                         ItemsSource="{Binding Headers}"
                                                         Margin="0,0,0,12"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ui:ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <ui:TextBox Grid.Column="0"
                                                                     Margin="0,0,4,0"
                                                                     Text="{Binding Name, Mode=TwoWay}"
                                                                     VerticalContentAlignment="Center"
                                                                     PlaceholderText="Header名称"/>

                                                            <ui:TextBox Grid.Column="1"
                                                                        Margin="4,0,4,0"
                                                                        Text="{Binding Value, Mode=TwoWay}"
                                                                        VerticalContentAlignment="Center"
                                                                        PlaceholderText="Header值"/>

                                                            <ui:Button Grid.Column="2"
                                                                       Content="删除"
                                                                       Appearance="Danger"
                                                                       MinWidth="60"
                                                                       Click="DeleteHeader_Click"
                                                                       />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ui:ListView.ItemTemplate>
                                            </ui:ListView>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Row="4"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,0,0">
                                                <!-- <ui:Button Content="保存更改" -->
                                                <!--            Appearance="Primary" -->
                                                <!--            MinWidth="80" -->
                                                <!--            Margin="0,0,8,0" -->
                                                <!--            /> -->
                                                <ui:Button Content="删除规则"
                                                           Appearance="Danger"
                                                           MinWidth="80"
                                                           Click="DeleteRule_Click"
                                                           />
                                            </StackPanel>
                                        </Grid>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>