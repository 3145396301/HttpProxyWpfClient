<Page x:Class="net8._0_ProxyWPF.code.Pages.Setting.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:net8._0_ProxyWPF.code.Pages.Setting"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="代理设置">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- 刷新代理部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="代理控制"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="立即刷新代理设置"
                                Name="RefreshProxyButton"
                                Click="RefreshProxyButton_OnClick"
                                Padding="16,8"
                                Margin="0,0,12,0"/>

                        <Button Content="关闭代理"
                                Name="CloseProxyButton"
                                Click="CloseProxyButton_OnClick"
                                Padding="16,8"
                                Background="#FFD72B2B"
                                Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 本地代理设置部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Expander Header="本地代理设置" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="代理地址:"
                                   VerticalAlignment="Center"
                                   Grid.Row="0" Grid.Column="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Name="LocalProxyAddressTextBox"
                                     Text="0.0.0.0"
                                     Margin="8,4"
                                     Padding="8,4"/>

                            <Label Content="代理端口:"
                                   VerticalAlignment="Center"
                                   Grid.Row="1" Grid.Column="0"
                                   Margin="0,12,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Name="LocalProxyPortTextBox"
                                     Text="8000"
                                     Padding="8,4"
                                     Margin="8,12,8,0"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 上游代理设置部分 -->
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="8" Padding="16">
                <Expander Header="上游代理设置" IsExpanded="True">
                    <StackPanel Margin="0,12,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="代理地址:"
                                   VerticalAlignment="Center"
                                   Grid.Row="0" Grid.Column="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Name="UpstreamProxyAddressTextBox"
                                     Text="127.0.0.1"
                                     Margin="8,4"
                                     Padding="8,4"/>

                            <Label Content="代理端口:"
                                   VerticalAlignment="Center"
                                   Grid.Row="1" Grid.Column="0"
                                   Margin="0,12,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Name="UpstreamProxyPortTextBox"
                                     Text="10808"
                                     Padding="8,4"
                                     Margin="8,12,8,0"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>