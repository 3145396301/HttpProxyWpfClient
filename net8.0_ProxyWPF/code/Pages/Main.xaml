<Page x:Class="net8._0_ProxyWPF.code.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:net8._0_ProxyWPF.code.Loc"
      mc:Ignorable="d"
      Title="Main"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部按钮栏 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <ui:Button Click="block_OnClick" Margin="0,0,5,0">拦截</ui:Button>
            <ui:Button Click="discharged_OnClick">全部放行</ui:Button>
        </StackPanel>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- 左侧会话列表 -->
            <ui:ListView Grid.Column="0" ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}"
                         SelectionChanged="Selector_OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingPanel.IsVirtualizing="False"
                         KeyDown="UIElement_OnKeyDown"
                         PreviewMouseRightButtonDown="SessionList_OnPreviewMouseRightButtonDown">
                <ui:ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制为 curl">
                            <MenuItem Header="cmd" Click="CopyCurlCmd_OnClick"/>
                            <MenuItem Header="bash" Click="CopyCurlBash_OnClick"/>
                            <MenuItem Header="PowerShell" Click="CopyCurlPowerShell_OnClick"/>
                        </MenuItem>
                    </ContextMenu>
                </ui:ListView.ContextMenu>
                <ui:ListView.View>
                    <ui:GridView>
                        <ui:GridViewColumn Header="上行" Width="40">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Orange">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockingRequest}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
                        <ui:GridViewColumn Header="下行" Width="40">
                            <ui:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Red">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Blocking}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ui:GridViewColumn.CellTemplate>
                        </ui:GridViewColumn>
<ui:GridViewColumn Header="{loc:Loc Host}" DisplayMemberBinding="{Binding Host}" Width="120" />
                        <ui:GridViewColumn Header="{loc:Loc Protocol}" DisplayMemberBinding="{Binding Protocol}" Width="70" />
                        <ui:GridViewColumn Header="{loc:Loc Method}" DisplayMemberBinding="{Binding Method}" Width="70" />
                        <ui:GridViewColumn Header="{loc:Loc Path}" DisplayMemberBinding="{Binding Url}" Width="200" />
                    </ui:GridView>
                </ui:ListView.View>
            </ui:ListView>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" />

            <!-- 右侧详情区域 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 请求内容 -->
                <Border Grid.Row="0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Text="请求内容" Margin="5,2" FontWeight="SemiBold" Foreground="White"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ui:TextBox Name="Request" BorderThickness="0" Background="Transparent"
                                     Text="{Binding RequestMessage.AllMessage}" TextWrapping="NoWrap"
                                     FontFamily="Consolas" AcceptsReturn="True" />
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                            <ui:Button Click="PassRequest_OnClick">放行</ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
<!-- 垂直分割线 -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeNS" />

                <!-- 响应内容 -->
                <Border Grid.Row="2" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Text="响应内容" Margin="5,2" FontWeight="SemiBold"
                                   Foreground="White" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ui:TextBox Name="Response" BorderThickness="0" Background="Transparent"
                                     Text="{Binding ResponseMessage.AllMessage}" TextWrapping="NoWrap"
                                     FontFamily="Consolas" AcceptsReturn="True" />
                        </ScrollViewer>

                        <!-- 操作按钮 + 失败/未完成提示 -->
                        <Grid Grid.Row="2" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBlock Grid.Column="0" Text="{Binding ResponseMessage.ErrorText}"
                                       Foreground="#FFD72B2B" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Cursor="Hand"
                                       MouseLeftButtonUp="ErrorText_OnClick">
                                <ui:TextBlock.Style>
                                    <Style TargetType="{x:Type ui:TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResponseMessage.HasError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:TextBlock.Style>
                            </ui:TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Click="Pass_OnClick" Margin="0,0,5,0">放行</ui:Button>
                                <ui:Button Name="ModifyRequestBody" Click="ModifyRequestBody_OnClick">快捷修改请求体</ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>